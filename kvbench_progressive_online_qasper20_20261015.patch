+def freeze_cases(source,out,task,n):
+    """No new tokenization or truncation. Immutable exact V3 cohort subset."""
+    manifest,datasets=checked_data(source)
+    if task not in datasets:raise ValueError('Requested task absent from frozen V3 LongBench: '+task)
+    rows=datasets[task]
+    if len(rows)<n:raise ValueError(f'Only {len(rows)} eligible frozen cases, required {n}')
+    selected=rows[:n]     # already deterministic hash-shuffled by V3 data_seed
+    if len({r['case_id'] for r in selected})!=n:raise ValueError('Duplicate case IDs')
+    out.mkdir(parents=True,exist_ok=False)
+    m=json.loads(json.dumps(manifest))
+    m['datasets']={task:dict(manifest['datasets'][task])}
+    m['settings']['sample_size']=n
+    m['subset_provenance']={'source_manifest_sha256':sha_file(Path(source)/'manifest.json'),
+         'source_dir':str(Path(source).resolve()),'selection':'first N in frozen hash-shuffled V3 order',
+         'source_selected_count':len(rows),'selected_count':n,'selected_case_ids':[r['case_id'] for r in selected]}
+    srcinfo=m['datasets'][task]
+    data_path=out/(task+'.jsonl')
+    write_jsonl(data_path,selected)
+    srcinfo.update(file=data_path.name,sha256=sha_file(data_path),selected_count=n,
+                   selected_case_ids=[r['case_id'] for r in selected],
+                   truncated_count=sum(bool(r['was_truncated']) for r in selected),
+                   cohort=f'locked V3 subset of {n}, no new truncation')
+    for k in ('raw_file',):
+        rel=srcinfo.get(k)
+        if rel:
+            sourcefile=Path(source)/rel
+            if not sourcefile.exists() or sha_file(sourcefile)!=srcinfo['raw_sha256']:
+                raise ValueError('Original LongBench raw source is missing/corrupt')
+            destination=out/rel;destination.parent.mkdir(parents=True,exist_ok=True)
+            shutil.copy2(sourcefile,destination)
+    atomic_json(out/'manifest.json',m)
+    checked,_=checked_data(out)
+    if checked['datasets'][task]['selected_count']!=n:raise AssertionError('Frozen subset invalid')
+    return selected
