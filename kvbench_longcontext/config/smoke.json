  "generation_budget_policy": "remaining-context",
  "request_max_tokens": null,
  "request_timeout_seconds": 0,
  "generation_config": "vllm",
  "override_generation_config": {},
  "concurrency": [1],
  "repeats": 1,
  "warmup_per_point": "concurrency count, min(32, remaining_context_tokens), excluded from measurement",
  "apc": false,
  "max_seqs": 16,
  "methods_in_order": ["fp16", "fp8", "kvarn", "tq4"]
