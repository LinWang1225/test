{
  "description": "v3 natural-generation thinking smoke recipe. This JSON is documentation; CLI does not auto-load it. Use the commands in README.zh-CN.md.",
  "datasets": ["qasper", "multifieldqa_en", "hotpotqa", "2wikimqa", "gov_report", "passage_retrieval_en"],
